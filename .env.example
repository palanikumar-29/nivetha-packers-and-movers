# Django Configuration
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (Leave empty for SQLite locally; set Neon PostgreSQL URL in production)
DATABASE_URL=

# Settings Module:
# - Local dev (manage.py): config.settings.local (DEBUG=True)
# - Production (gunicorn / Render): config.settings.production (DEBUG=False, SECURE_SSL_REDIRECT, secure cookies)
# Note: config/wsgi.py defaults to config.settings.production as a fail-safe.
DJANGO_SETTINGS_MODULE=config.settings.local

# Storage Configuration (False uses local disk media/; True uses Cloudinary)
USE_CLOUDINARY=False
CLOUDINARY_URL=

# Business Contact (Used for tel: and wa.me links; never hardcoded)
BUSINESS_PHONE=
BUSINESS_WHATSAPP=
BUSINESS_ADDRESS=Tiruppur, Tamil Nadu

# Optional Notifications (Telegram disabled by default; owner does not use it)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

